{
	"compilerOptions": {
		"strict": true,
		"target": "es2024",
		"lib": ["es2024", "dom"],
		"module": "nodenext",
		"declaration": true,
		"stripInternal": true,
		"declarationMap": false,
		"newLine": "lf",
		"sourceMap": false,
		"noEmitOnError": true,
		"esModuleInterop": true,
		"types": [],
		"rootDir": "src",
		"outDir": "dist"
	},
	"include": [
		"src"
	]
}
